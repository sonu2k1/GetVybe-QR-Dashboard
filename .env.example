# Supabase Project Credentials
# Find these in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-to-browser

# Admin Security Token
# Protects write actions. Use a long, secure random string.
ADMIN_SECRET=your-secure-admin-secret-token

# PWA Scan Resolution URL
# Base URL prefix where scanned QRs point. E.g. https://yourpwa.com/scan
NEXT_PUBLIC_SCAN_BASE_URL=https://yourpwa.com/scan
